{
  "expo": {
    "name": "Tourousum",
    "slug": "tourousum",
    "version": "1.0.0",
    "description": "Tourousum — modern mobile travel booking & itinerary app.",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "sdkVersion": "57.0.0",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00A896"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.tourousum.app" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#ffffff" },
      "package": "com.tourousum.app"
    },
    "web": { "bundler": "metro", "path": "/Bharat-Darshan-/" },
    "updates": { "fallbackToCacheTimeout": 0 },
    "plugins": ["expo-notifications"]
  }
}
